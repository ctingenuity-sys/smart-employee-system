{
  "manifest_version": 3,
  "name": "Smart Employee & IHMS Bridge",
  "version": "4.3.0",
  "description": "Auto-sync patient & radiology worklist from Hospital System (IHMS) to Smart Radiology Logbook.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "smart-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "smart-bridge.js",
        "content-relay.js",
        "background.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
